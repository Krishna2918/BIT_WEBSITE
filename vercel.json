    { "source": "/security-camera-installation-brampton", "destination": "/hardware", "statusCode": 301 },
    { "source": "/security-camera-installation-brampton/", "destination": "/hardware", "statusCode": 301 },
    { "source": "/sitemap", "destination": "/sitemap.xml", "statusCode": 301 },
    { "source": "/sitemap/", "destination": "/sitemap.xml", "statusCode": 301 },
    { "source": "/cloud-backup-vs-local-storage-brampton", "destination": "/insights/backup-vs-local", "statusCode": 301 },
    { "source": "/cloud-backup-vs-local-storage-brampton/", "destination": "/insights/backup-vs-local", "statusCode": 301 },

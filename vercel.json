{
  "framework": null,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/images/:path*",
      "destination": "https://cdn.jsdelivr.net/gh/Krishna2918/BIT_WEBSITE@main/public/images/:path*"
    },
    {
      "source": "/videos/:path*",
      "destination": "https://cdn.jsdelivr.net/gh/Krishna2918/BIT_WEBSITE@main/public/videos/:path*"
    },
    {
      "source": "/downloads/:path*",
      "destination": "https://cdn.jsdelivr.net/gh/Krishna2918/BIT_WEBSITE@main/public/downloads/:path*"
    },
    {
      "source": "/og.jpg",
      "destination": "https://cdn.jsdelivr.net/gh/Krishna2918/BIT_WEBSITE@main/public/og.jpg"
    }
  ]
}

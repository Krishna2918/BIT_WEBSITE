{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:preview",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://livechat.bitsolution.ca; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://challenges.cloudflare.com https://livechat.bitsolution.ca wss://livechat.bitsolution.ca; frame-src https://challenges.cloudflare.com https://livechat.bitsolution.ca; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/about-us", "destination": "/", "permanent": true },
    { "source": "/solutions", "destination": "/", "permanent": true },
    { "source": "/blog", "destination": "/insights", "permanent": true },
    { "source": "/contact", "destination": "/consult", "permanent": true },
    { "source": "/manage-it-services-brampton", "destination": "/service-areas", "permanent": true },
    { "source": "/managed-it-services", "destination": "/service-areas", "permanent": true },
    { "source": "/office-network-installation-brampton", "destination": "/hardware", "permanent": true },
    { "source": "/procurement-services", "destination": "/procurement", "permanent": true },
    { "source": "/digital-marketing-services-brampton", "destination": "/digital-marketing", "permanent": true },
    { "source": "/cloud-services-brampton", "destination": "/software", "permanent": true },
    { "source": "/cyber-security-services-brampton", "destination": "/security", "permanent": true },
    { "source": "/business-voip-phone-service-brampton", "destination": "/voip", "permanent": true },
    { "source": "/security-camera-installation-brampton", "destination": "/hardware", "permanent": true },
    { "source": "/sample-page", "destination": "/", "permanent": true },
    { "source": "/hero-section", "destination": "/", "permanent": true },
    { "source": "/404-2", "destination": "/", "permanent": true },
    { "source": "/sitemap", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/category/it", "destination": "/insights", "permanent": true },
    { "source": "/author/admin", "destination": "/insights", "permanent": true },
    { "source": "/how-to-choose-a-managed-it-services-provider", "destination": "/insights/managed-it-time", "permanent": true },
    { "source": "/cyber-security-tips-for-small-businesses", "destination": "/insights/cyber-mistakes", "permanent": true },
    { "source": "/5-biggest-benefits-of-cloud-backups", "destination": "/insights/why-cloud-backup", "permanent": true },
    { "source": "/10-signs-your-business-needs-managed-it-support", "destination": "/insights/managed-it-time", "permanent": true },
    { "source": "/top-7-cyber-security-solutions-every-business-needs-in-2025", "destination": "/insights/protect-your-business", "permanent": true },
    { "source": "/why-businesses-need-reliable-cloud-backup-services-in-canada", "destination": "/insights/why-cloud-backup", "permanent": true },
    { "source": "/top-cybersecurity-mistakes-businesses-make-and-how-to-avoid-them", "destination": "/insights/cyber-mistakes", "permanent": true },
    { "source": "/managed-it-services-brampton-save-time-money", "destination": "/insights/managed-it-time", "permanent": true },
    { "source": "/cloud-backup-vs-local-storage-brampton", "destination": "/insights/backup-vs-local", "permanent": true },
    { "source": "/struggling-with-cyber-attacks-protect-your-business", "destination": "/insights/protect-your-business", "permanent": true },
    { "source": "/easy-cloud-migration-for-businesses", "destination": "/insights/cloud-migration", "permanent": true }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:preview",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-src 'none'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.bitsolution.ca" }], "destination": "https://bitsolution.ca/:path*", "statusCode": 301 },
    { "source": "/blog", "destination": "/insights", "statusCode": 301 },
    { "source": "/blog/", "destination": "/insights", "statusCode": 301 },
    { "source": "/contact", "destination": "/consult", "statusCode": 301 },
    { "source": "/contact/", "destination": "/consult", "statusCode": 301 },
    { "source": "/manage-it-services-brampton", "destination": "/support", "statusCode": 301 },
    { "source": "/manage-it-services-brampton/", "destination": "/support", "statusCode": 301 },
    { "source": "/managed-it-services", "destination": "/support", "statusCode": 301 },
    { "source": "/managed-it-services/", "destination": "/support", "statusCode": 301 },
    { "source": "/office-network-installation-brampton", "destination": "/hardware", "statusCode": 301 },
    { "source": "/office-network-installation-brampton/", "destination": "/hardware", "statusCode": 301 },
    { "source": "/procurement-services", "destination": "/procurement", "statusCode": 301 },
    { "source": "/procurement-services/", "destination": "/procurement", "statusCode": 301 },
    { "source": "/digital-marketing-services-brampton", "destination": "/digital-marketing", "statusCode": 301 },
    { "source": "/digital-marketing-services-brampton/", "destination": "/digital-marketing", "statusCode": 301 },
    { "source": "/cyber-security-services-brampton", "destination": "/security", "statusCode": 301 },
    { "source": "/cyber-security-services-brampton/", "destination": "/security", "statusCode": 301 },
    { "source": "/business-voip-phone-service-brampton", "destination": "/voip", "statusCode": 301 },

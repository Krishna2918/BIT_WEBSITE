# Public browser flags remain off until the separately approved activation gate.
VITE_ASK_AI_ENABLED=false
VITE_CHATWOOT_ENABLED=false
VITE_CHATWOOT_BASE_URL=https://livechat.bitsolution.ca
VITE_CHATWOOT_SDK_PATH=/packs/js/sdk.js
VITE_CHATWOOT_WEBSITE_TOKEN=

# Production indexing, measurement, and bot protection remain off in preview.
VITE_PUBLIC_HOSTNAME=
VITE_SITE_INDEXABLE=0
VITE_MEASUREMENT_ON=0
VITE_GTM_ID=
VITE_GA4_ID=
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=

# Server-only Ask AI configuration. Never give these values a VITE_ prefix.
BIT_PUBLIC_AI_ENABLED=false
BIT_PUBLIC_AI_MODEL=openai/gpt-5.6-luna
BIT_PUBLIC_AI_FIREWALL_RATE_LIMIT_CONFIRMED=false
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# Server-only consultation delivery. The API fails closed while these are empty.
FORM_AI_CRM_ADAPTER_URL=
FORM_AI_CRM_ADAPTER_TOKEN=
FORM_AI_TEAMS_ADAPTER_URL=
FORM_AI_TEAMS_ADAPTER_TOKEN=
FORM_AI_STAFFED_WEEKDAYS=1,2,3,4,5
FORM_AI_STAFFED_START=08:00
FORM_AI_STAFFED_END=18:00
FORM_AI_TURNSTILE_ENABLED=false
FORM_AI_TURNSTILE_SECRET_KEY=
FORM_AI_TURNSTILE_EXPECTED_HOSTNAMES=
FORM_AI_TURNSTILE_EXPECTED_ACTION=consult
